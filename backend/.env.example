# Copy to backend/.env for local development (never commit the real file). Names only - fill values locally.
# For the docker compose stack use the root .env.example instead; it passes these through to the backend.

# --- core ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=vidhi
# Comma-separated explicit origins, e.g. https://app.example.in  (a wildcard is ignored: credentialed requests must never be open to any site)
CORS_ORIGINS=http://localhost:3000
# Public address of the web app. Used in emailed links and as an allowed origin.
APP_URL=http://localhost:3000
# Cookies are Secure by default. Set to false ONLY for plain-http local development.
COOKIE_SECURE=true
# Set true only when behind your own reverse proxy, so rate limits use X-Forwarded-For.
TRUST_PROXY=false
# API docs (/docs) are off unless true. Never enable in production.
ENABLE_DOCS=false
APP_TZ=Asia/Kolkata
# Optional rate-limit overrides (max hits per window): RATE_LIMIT_SIGNUP, RATE_LIMIT_AI, RATE_LIMIT_EMAIL, ...

# --- AI: Google Gemini ---
GEMINI_API_KEY=
# Defaults to gemini-3.8-flash. Check Google's current model list before changing.
GEMINI_MODEL=
AI_TIMEOUT_SECONDS=120
# Max characters of matter text sent to the model per question (all of it if it fits; the answer states what was not read).
MAX_CONTEXT_CHARS=80000
# Folder of reviewed verified-law entries (see backend/data/legal_library/README.md). Default: backend/data/legal_library
LIBRARY_DIR=

# --- payments: Stripe ---
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint https://<your-domain>/api/webhook/stripe (starts with whsec_)
STRIPE_WEBHOOK_SECRET=
# The price is configuration, never client input. Pro is Rs 1,999 a month (PRO_PRICE_AMOUNT=1999 PRO_PRICE_CURRENCY=inr); the AI a Pro person can use is limited in .env.example (AI_USER_*).
PRO_PRICE_AMOUNT=1999
PRO_PRICE_CURRENCY=inr

# --- email: Resend ---
RESEND_API_KEY=
# A sender on a domain you have verified in Resend (SPF + DKIM), e.g.  VIDHI <notices@mail.example.in>
EMAIL_FROM=
EMAIL_REPLY_TO=
# Signing secret of the webhook endpoint https://<your-domain>/api/webhooks/resend (starts with whsec_).
# Subscribe it to: email.delivered, email.bounced, email.complained
RESEND_WEBHOOK_SECRET=

# --- scheduled jobs + signed links ---
# Long random string; the scheduler sends it as "Authorization: Bearer <value>" to /api/cron/*
WEBHOOK_CRON_SECRET=
# Signs consent / unsubscribe links. Long random string; changing it invalidates links already emailed.
LINK_SECRET=

# --- TESTS / LOCAL ONLY: never true in production ---
AI_STUB=false
PAYMENTS_STUB=false
EMAIL_DRY_RUN=false

# Apify tokens for the judgement-lookup actor (spike, Stage 1). Put real values only in backend/.env.
APIFY_API_TOKEN=
APIFY_API_TOKEN_2=

# Optional OCR: a folder holding extra Tesseract language files (hin, tel, tam, ...) and a copy of the install's "configs" folder; and the languages to read, for example eng+tel+hin+tam.
OCR_TESSDATA_DIR=
OCR_LANGUAGES=
