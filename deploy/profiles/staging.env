# Staging: a copy of production for trying a release on a separate address and a separate database, with invited testers only.
# Only choices that DIFFER from .env.example are listed here. Secrets never go in this file (they come from the host's secret store).
DB_NAME=vidhi_staging
SIGNUP_MODE=invite
UPLOAD_MAX_DAYS=30
DEFAULT_RETENTION_DAYS_AFTER_CLOSE=365
AUTHORITY_CHECK_ENABLED=true
DATE_LIST_ENABLED=true
DEFECT_CHECK_ENABLED=true
OLD_CODE_CHECK_ENABLED=true
DEADLINE_ENGINE_ENABLED=true
SENTRY_ENVIRONMENT=staging
# Pilot spending limits (5 to 10 lawyers on sample or public drafts): small on purpose, so a mistake or a loop cannot spend much. Raise them when the pilot ends and the real cost ledger has been read.
AI_MONTHLY_CAP_INR=1500
AI_DAILY_CAP_INR=150
AI_FREE_DAILY_CAP_INR=100
FREE_AI_PER_DAY=10
